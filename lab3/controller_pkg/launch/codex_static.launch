<launch>
  <param name="hz" type="double" value="100"/>
  <param name="kx" type="double" value="2.5"/>
  <param name="kv" type="double" value="2.0"/>
  <param name="kr" type="double" value="4.0"/>
  <param name="komega" type="double" value="1.2"/>
  <param name="ki_z" type="double" value="0.15"/>
  <param name="max_motor_speed" type="double" value="500.0"/>
  <node pkg="controller_pkg" type="controller_node" name="controller_node" output="screen"/>
  <node pkg="controller_pkg" type="static_pose_publisher.py" name="traj_publisher" output="screen">
    <param name="x" value="0.0"/>
    <param name="y" value="-0.24"/>
    <param name="z" value="2.0"/>
    <param name="yaw" value="0.7853981634"/>
  </node>
</launch>
